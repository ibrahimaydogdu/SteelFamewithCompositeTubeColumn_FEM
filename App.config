<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
  <appSettings>
    <!-- ETABS 22 (ETABS 19: "...\ETABS 19\ETABS.exe" and AISC14M.xml). If the path does not exist the newest installed ETABS is used. -->
    <add key="ETABSProgramPath" value="C:\Program Files\Computers and Structures\ETABS 22\ETABS.exe" />
    <add key="SectionPropertyDataPath" value="C:\Program Files\Computers and Structures\ETABS 22\Property Libraries\AISC16M.xml" />
    <!-- Auto select lists used for the initial design (upper / lower bounds). Created with all W sections if missing. -->
    <add key="BeamAutoSelectList" value="BeamSectionList" />
    <add key="ColumnAutoSelectList" value="ColumnSectionList" />
    <!-- Folder of the working copies of the model (analysis files), deleted at the end of the run. Empty = %TEMP%\SteelFrameOpt -->
    <add key="WorkFolder" value="" />
    <!-- Service drift mode: load factor of the SRV_<pattern> cases created for wind / earthquake patterns when the model has no pure lateral case -->
    <add key="ServiceLateralFactor" value="1.0" />
    <!-- Service drift mode: displacements of seismic cases (earthquake patterns, response spectrum) are multiplied by this factor (ASCE 7: Cd/Ie, TBDY 2018: R/I) -->
    <add key="SeismicDriftAmplification" value="1.0" />
    <!-- Internal composite strength ratios are multiplied by this factor (calibration to the ETABS composite design; the final check logs the matching value) -->
    <add key="CompositeStrengthFactor" value="1.0" />
    <!-- D/C ratio limit of the steel and composite column designs. Empty: the limits of the ETABS design preferences of the model
         (DCLimit, ETABS default 0.95). A value (e.g. 1.0 = AISC 360) is written to the working copy. Design ratios are divided by the limit. -->
    <add key="DesignRatioLimit" value="" />
    <!-- Upper search bound of every group = section of the strength design (ETABS auto select) + shift + this fraction of the section list.
         0.23 = default (designs governed by strength). Story drift governed problems (e.g. seismic with Cd/Ie amplification): 1 = the whole list. -->
    <add key="UpperBoundMultiplier" value="0.23" />
    <!-- true (default): the design with every variable at its upper bound is analysed once at the start; while it violates the story drift limits
         the upper bounds are raised (by UpperBoundMultiplier of the section list at a time, up to the whole list). Designs that are feasible
         at the first bounds are not changed. false: bounds stay as computed. -->
    <add key="WidenBoundsForDrift" value="true" />
    <!-- AISC 341 ductility filter (Table D1.1): auto = only when the AISC 341 checks are active in the model (strong column - weak beam ratios exist)
         and the framing type is SMF (highly ductile) or IMF (moderately ductile); on = always (SMF/IMF level, else High); off = never.
         Sections that are not seismically compact are replaced by the nearest compliant one before every analysis. -->
    <add key="SeismicDuctilityFilter" value="auto" />
    <!-- Axial load ratio Pu/(phi Py) assumed for the web limit of the columns in the filter -->
    <add key="SeismicColumnCa" value="0.3" />
  </appSettings>
</configuration>

