<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <runtime>
        <!-- Server garbage collector: the parallel element loops of the FEM evaluator allocate a lot of small arrays (2.4 times faster than the workstation collector) -->
        <gcServer enabled="true" />
        <gcConcurrent enabled="false" />
    </runtime>
  <appSettings>
    <!-- Initial state of the form option "FEM solver (fast)": Fem (default) | Etabs. Etabs = ETABS analyses every candidate (reference, slow); Fem = own FEM solver (about 100 times faster; ETABS checks the final design).
         A model or option that the FEM evaluator cannot handle (composite columns, area objects, ...) keeps ETABS. -->
    <add key="Evaluator" value="Fem" />
    <!-- Fem evaluator: the FEM D/C ratios of the members are multiplied by this factor (the FEM ratios are 0.4-2.4 % below ETABS on average; 1.01-1.02 makes the
         ETABS check of the final design pass more often, 1.0 = no margin). The final design is always checked with ETABS and corrected by guard steps. -->
    <add key="FemRatioMargin" value="1.01" />
    <!-- PCR-15, FemModalMass dense | sparse: reduced mass matrix of the FEM modal analysis. dense = earlier versions; sparse = only the nonzero
         (lumped) terms, the same equations, faster on tall models (results may differ in the last digits) -->
    <add key="FemModalMass" value="dense" />
    <!-- ETABS 22 (ETABS 19: "...\ETABS 19\ETABS.exe" and AISC14M.xml). If the path does not exist the newest installed ETABS is used. -->
    <add key="ETABSProgramPath" value="C:\Program Files\Computers and Structures\ETABS 22\ETABS.exe" />
    <add key="SectionPropertyDataPath" value="C:\Program Files\Computers and Structures\ETABS 22\Property Libraries\AISC16M.xml" />
    <!-- Auto select lists used for the initial design (upper / lower bounds). Created with all W sections if missing. -->
    <add key="BeamAutoSelectList" value="BeamSectionList" />
    <add key="ColumnAutoSelectList" value="ColumnSectionList" />
    <!-- Folder of the working copies of the model (analysis files), deleted at the end of the run. Empty = %TEMP%\SteelFrameOpt -->
    <add key="WorkFolder" value="" />
    <!-- Service drift mode: load factor of the SRV_<pattern> cases created for wind / earthquake patterns when the model has no pure lateral case -->
    <add key="ServiceLateralFactor" value="1.0" />
    <!-- Service drift mode: displacements of seismic cases (earthquake patterns, response spectrum) are multiplied by this factor (ASCE 7: Cd/Ie, TBDY 2018: R/I) -->
    <add key="SeismicDriftAmplification" value="1.0" />
    <!-- Internal composite strength ratios are multiplied by this factor (calibration to the ETABS composite design; the final check logs the matching value) -->
    <add key="CompositeStrengthFactor" value="1.0" />
    <!-- Filled tubes: unit cost of the tube steel relative to the steel unit cost (rolled W), for built-up boxes and library HSS.
         1.0 = the same price as W steel (results of earlier versions). Paper 1: built-up 1.02, HSS 1.35 (official unit price schedules). -->
    <add key="TubeSteelCostFactorBuiltUp" value="1.0" />
    <add key="TubeSteelCostFactorHSS" value="1.0" />
    <!-- Folder of the initial design cache (ETABS initial design and widened search bounds, computed once per model and settings).
         Empty = no cache (earlier versions). The key covers the model, App.config, the program, the section libraries and the form settings. -->
    <add key="InitialDesignCache" value="" />
    <!-- Drift limits by load type (drift mode "lateral cases only"). legacy = both limits for every lateral case (earlier versions).
         split = seismic cases (x SeismicDriftAmplification): inter-story limit h / InterStoryDriftR only (ASCE 7-22 Table 12.12-1: 0.020 h = h / 50);
         wind cases: top drift limit H / TopStoryDriftR only (e.g. H / 400), displacements x WindDriftFactor (service wind level). -->
    <add key="DriftLimits" value="legacy" />
    <add key="WindDriftFactor" value="1.0" />
    <!-- AISC 341 options (Paper 1, PCR-5). Every default reproduces the earlier versions; AISC 341-22: Aisc341Edition 2022, SeismicSCWB auto,
         CompositeDamReduction true, FinalProtocol unmodified, TubeSeismicDuctility auto.
         Aisc341Edition: legacy (341-16 width-to-thickness limits, Lb 0.095/0.19, CFT walls without Ry) | 2022
         SeismicSCWB: legacy (when ETABS reports beam/column ratios) | auto (SMF and C-SMF with AISC 341 on) | on | off
         CompositeDamReduction: false | true (filled composite columns 0.8 EA, 0.64 EIeff, AISC 360-22 I1.5)
         FinalProtocol: legacy | unmodified (a final design changed by guard steps is a failed verification)
         TubeSeismicDuctility: xml (TubeSections.xml) | auto (SMF High, IMF Moderate, AISC 341 off: none)
         InteriorColumnsSteel: false | true (composite mode: the interior gravity columns stay W sections)
         ScwbBeamSide: calibrated (closed form fitted to ETABS) | code (AISC 341-22 Eq. E3-3 / G3.4a) -->
    <add key="Aisc341Edition" value="legacy" />
    <add key="SeismicSCWB" value="legacy" />
    <add key="CompositeDamReduction" value="false" />
    <add key="FinalProtocol" value="legacy" />
    <add key="TubeSeismicDuctility" value="xml" />
    <add key="InteriorColumnsSteel" value="false" />
    <!-- name prefix of the interior (gravity) column groups for InteriorColumnsSteel (ModelBuilder: COL-INTERIOR-<band>) -->
    <add key="InteriorColumnGroups" value="COL-INTERIOR" />
    <!-- name prefix of the corner column groups (AISC 341-22 E3.3: the beam/column ratios of ETABS are not used for them) -->
    <add key="CornerColumnGroups" value="COL-CORNER" />
    <!-- Corner columns (PCR-10): mode = they follow the mode of the run, W sections in the steel mode (earlier versions, tag paper1-pre-box) |
         box = a corner column group that is not composite takes an unfilled square box (library HSS and built-up boxes of TubeSections.xml,
         ETABS Tube section, steel design): steel mode corners unfilled boxes, hybrid corner stacks filled -> unfilled box -->
    <add key="CornerColumns" value="mode" />
    <!-- box catalog of CornerColumns = box: connection limits of AISC 358-22 5.3.2 (RBS prequalified for built-up box columns up to 600 mm,
         also in orthogonal moment frames). CornerBoxBuiltUpOnly true (library HSS not used) | false; CornerBoxMaxWidth [mm], 0 = no limit -->
    <add key="CornerBoxBuiltUpOnly" value="true" />
    <add key="CornerBoxMaxWidth" value="600" />
    <add key="ScwbBeamSide" value="calibrated" />
    <!-- PCR-11, AISC 341-22 corner check (defaults = PCR-5g): CornerBeamSide full | rbs (beams with the reduced beam section of AISC 358-22
         5.7, c = 0.25 bbf, Mpr at Sh projected to the column; AISC 358-22 5.7 Step 1 then asks for elastic drifts x 1.1, set by
         SeismicDriftAmplification); CornerOrthogonal 100 (Omega0 (|RSx| + |RSy|)) | 30 (ASCE 7-22 12.5.1.2(a) 100 % + 30 %);
         CornerRoofExemption false | true (AISC 341-22 E3.4a exception (a)(1) at the roof corner joints, as in the storey check) -->
    <add key="CornerBeamSide" value="full" />
    <add key="CornerOrthogonal" value="100" />
    <add key="CornerRoofExemption" value="false" />
    <!-- PCR-12, BeamPrequalification none | rbs: the beam sections are limited to the RBS beam limitations of AISC 358-22 5.3.1 (2) to (4)
         (depth up to W1100, weight up to 610 kg/m, flange thickness up to 53 mm) through the AISC 341 ductility filter (SMF / IMF) -->
    <add key="BeamPrequalification" value="none" />
    <!-- PCR-13, ColumnPrequalification none | rbs: the W column sections are limited to W1000 (AISC 358-22 5.3.2(3), rolled column depth of
         the RBS connection) through the AISC 341 ductility filter; box widths: CornerBoxMaxWidth and TubeSections.xml BuiltUpMax -->
    <add key="ColumnPrequalification" value="none" />
    <!-- PCR-14, DriftRepairExclude: group name prefixes (comma separated) of columns that the drift repair does not enlarge, e.g. COL-INTERIOR
         (gravity columns of a perimeter frame); empty = every column group (earlier versions) -->
    <add key="DriftRepairExclude" value="" />
    <!-- D/C ratio limit of the steel and composite column designs. Empty: the limits of the ETABS design preferences of the model
         (DCLimit, ETABS default 0.95). A value (e.g. 1.0 = AISC 360) is written to the working copy. Design ratios are divided by the limit. -->
    <add key="DesignRatioLimit" value="" />
    <!-- Upper search bound of every group = section of the strength design (ETABS auto select) + shift + this fraction of the section list.
         0.23 = default (designs governed by strength). Story drift governed problems (e.g. seismic with Cd/Ie amplification): 1 = the whole list. -->
    <add key="UpperBoundMultiplier" value="0.23" />
    <!-- true (default): the design with every variable at its upper bound is analysed once at the start; while it violates the story drift limits
         the upper bounds are raised (by UpperBoundMultiplier of the section list at a time, up to the whole list). Designs that are feasible
         at the first bounds are not changed. false: bounds stay as computed. -->
    <add key="WidenBoundsForDrift" value="true" />
    <!-- AISC 341 ductility filter (Table D1.1): auto = only when the AISC 341 checks are active in the model (strong column - weak beam ratios exist)
         and the framing type is SMF (highly ductile) or IMF (moderately ductile); on = always (SMF/IMF level, else High); off = never.
         Sections that are not seismically compact are replaced by the nearest compliant one before every analysis. -->
    <add key="SeismicDuctilityFilter" value="auto" />
    <!-- Axial load ratio Pu/(phi Py) assumed for the web limit of the columns in the filter -->
    <add key="SeismicColumnCa" value="0.3" />
  </appSettings>
</configuration>

